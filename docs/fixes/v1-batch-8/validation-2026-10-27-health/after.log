[31m+           `);[39m
[31m+           await db.execute(sql`[39m
[31m+             CREATE OR REPLACE FUNCTION enforce_and_audit_ga4_connection_lifecycle()[39m
[31m+             RETURNS TRIGGER[39m
[31m+             LANGUAGE plpgsql[39m
[31m+             AS $function$[39m
[31m+             DECLARE[39m
[31m+               lifecycle_actor TEXT := COALESCE(NULLIF(current_setting('app.ga4_connection_actor', true), ''), current_user);[39m
[31m+               lifecycle_reason TEXT := NULLIF(current_setting('app.ga4_connection_reason', true), '');[39m
[31m+             BEGIN[39m
[31m+               IF TG_OP = 'UPDATE' AND OLD.is_active = true AND NEW.is_active = false THEN[39m
[31m+                 RAISE EXCEPTION 'GA4_CONNECTION_DEACTIVATION_BLOCKED: use the campaign-scoped disconnect path';[39m
[31m+               END IF;[39m
[31m+               IF TG_OP = 'INSERT' THEN[39m
[31m+                 INSERT INTO ga4_connection_lifecycle_events[39m
[31m+                   (connection_id, campaign_id, property_id, action, actor, reason)[39m
[31m+                 VALUES[39m
[31m+                   (NEW.id, NEW.campaign_id, NEW.property_id, 'connected', lifecycle_actor,[39m
[31m+                    COALESCE(lifecycle_reason, 'ga4_connection_created'));[39m
[31m+                 RETURN NEW;[39m
[31m+               END IF;[39m
[31m+               IF TG_OP = 'DELETE' THEN[39m
[31m+                 INSERT INTO ga4_connection_lifecycle_events[39m
[31m+                   (connection_id, campaign_id, property_id, action, actor, reason)[39m
[31m+                 VALUES[39m
[31m+                   (OLD.id, OLD.campaign_id, OLD.property_id, 'disconnected', lifecycle_actor,[39m
[31m+                    COALESCE(lifecycle_reason, 'ga4_connection_deleted'));[39m
[31m+                 RETURN OLD;[39m
[31m+               END IF;[39m
[31m+               IF OLD.is_active = false AND NEW.is_active = true THEN[39m
[31m+                 INSERT INTO ga4_connection_lifecycle_events[39m
[31m+                   (connection_id, campaign_id, property_id, action, actor, reason)[39m
[31m+                 VALUES[39m
[31m+                   (NEW.id, NEW.campaign_id, NEW.property_id, 'reactivated', lifecycle_actor,[39m
[31m+                    COALESCE(lifecycle_reason, 'ga4_connection_reactivated'));[39m
[31m+               END IF;[39m
[31m+               RETURN NEW;[39m
[31m+             END;[39m
[31m+             $function$;[39m
[31m+           `);[39m
