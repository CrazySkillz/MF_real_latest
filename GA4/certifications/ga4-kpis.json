  "configurationBoundary": {
    "platformType": "google_analytics",
    "scope": "Actor-owned campaign, exact google_analytics platform rows, selected GA4 property, saved GA4 campaign filter, campaign-scoped revenue and spend sources, and campaign reporting timezone.",
    "includedSurfaces": [
      "GA4 KPI create, edit, delete, list, cards, tracker, and browser PDF",
      "daily, on-demand, source-lifecycle, and report-preflight recomputation",
      "KPI progress persistence and destructive child cleanup",
      "in-app alerts, notification enrichment, bell state, Notifications, and locally tested alert-email eligibility",
      "GA4 Insights KPI context",
      "browser, direct snapshot, test-send, manual, and scheduled report consumers"
    ],
    "sourceRules": [
      "Traffic and rate metrics remain selected-property and selected-campaign scoped.",
      "Financial values must use fixed documented source precedence; valid zero is authoritative and unavailable must not become zero.",
      "Persisted recompute uses fixed native/imported financial-source precedence and preserves affected last-good stored values when required native, revenue, or spend inputs are unavailable.",
      "Blocked, insufficient, unavailable, or preserved-last-good values are not treated as verified breaches by backend alert, email-eligibility, bell, or Notifications consumers.",
      "Loading, failed, unavailable, stale/last-good, blocked, or insufficient KPI values are not scored, pulsed, or described as verified performance by browser consumers.",
      "Recompute returns exact KPI updated/skipped/failed identities, and selected-row freshness is required before source-lifecycle alert sweeps or report generation continue.",
      "KPI progress capacity aligns with KPI values, and exact notification hiding plus KPI child/parent deletion is atomic and retryable.",
      "Custom and unsupported KPI values must not be overwritten by guessed recomputation."
    ],
    "windowRules": [
      "Traffic and rate KPIs use the saved initial-import boundary through the latest completed reporting day in the campaign reporting timezone.",
      "Engagement Rate must be weighted from authoritative inputs.",
      "Persisted recompute, notification enrichment, and read-only comparison inputs use the same boundary; exact-current deployed parity passed within the recorded boundary.",
      "Traffic/rate browser consumers use the initial-import-to-latest-completed-day contract; financial KPI browser consumers use campaign/source-to-date inputs."
    ],
    "ownershipRules": [
      "Every KPI read and mutation must prove actor, campaign, KPI owner, and exact platform scope.",
      "Active canonical GA4 KPI creation must serialize within one campaign, treat standard and legacy aliases as one metric identity, and remain independent across campaigns and owners.",
      "Schedulers and reports must fail closed when campaign, property, source, or exact refreshed KPI identity cannot be proven.",
      "Delete and visibility behavior must not affect another campaign, client, platform, KPI, or notification."
    ]
  },
